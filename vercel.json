{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(sitemap.xml|robots.txt|manifest.json|favicon.jpeg|googlee405a0af42495f4e.html)",
      "destination": "/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}

